+/* The memory map the core registered with RETRO_ENVIRONMENT_SET_MEMORY_MAPS,
+ * after RetroArch's preprocessing -- the same descriptors RetroArch's own
+ * cheevos integration hands to rc_libretro. Frontends that run rcheevos in JS
+ * need it to see the core's whole address space (get_memory_data only
+ * exposes the SYSTEM/SAVE/VIDEO RAM blocks).
+ *
+ * One "flags|ptr|offset|start|select|disconnect|len" record per descriptor,
+ * ';'-separated; "" when the core registered no map. The buffer is owned
+ * here and reused between calls -- do not free it. */
+char* ejs_get_memory_map(void) {
+   static char *buf = NULL;
+   static size_t cap = 0;
+   runloop_state_t *runloop_st      = runloop_state_get_ptr();
+   const rarch_memory_map_t *mmaps  = &runloop_st->system.mmaps;
+   size_t need = (size_t)mmaps->num_descriptors * 128 + 1;
+   size_t len  = 0;
+   unsigned i;
+
+   if (need > cap) {
+      char *grown = (char*)realloc(buf, need);
+      if (!grown)
+         return (char*)"";
+      buf = grown;
+      cap = need;
+   }
+   buf[0] = '\0';
+
+   for (i = 0; i < mmaps->num_descriptors && len < cap; i++) {
+      const struct retro_memory_descriptor *d = &mmaps->descriptors[i].core;
+      len += snprintf(buf + len, cap - len, "%s%llu|%lu|%lu|%lu|%lu|%lu|%lu",
+            i ? ";" : "",
+            (unsigned long long)d->flags,
+            (unsigned long)(uintptr_t)d->ptr,
+            (unsigned long)d->offset,
+            (unsigned long)d->start,
+            (unsigned long)d->select,
+            (unsigned long)d->disconnect,
+            (unsigned long)d->len);
+   }
+   return buf;
+}
+
 bool ejs_is_paused(void) {
    return EJS_PAUSED;
 }
